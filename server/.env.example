# Copy this file to ".env" and fill in real values. Never commit ".env" to git.

# Port the API server listens on
PORT=5000

# Where the SQLite database file should live (created automatically on first run)
DATABASE_PATH=./data/school.db

# Secret used to sign teacher login tokens (JWT).
# Set this to a long, random, unguessable string in production.
JWT_SECRET=change_this_to_a_long_random_string

# How long a teacher's login session stays valid
JWT_EXPIRES_IN=12h

# The URL(s) of your frontend, comma-separated, allowed to call this API
CORS_ORIGIN=http://localhost:5173
